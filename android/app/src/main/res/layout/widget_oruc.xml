<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/bg_oruc_night" android:padding="12dp">
    <TextView android:id="@+id/o_lbl" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#CCFFFFFF" android:maxLines="1" android:textStyle="bold" />
    <Chronometer android:id="@+id/o_ch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:textColor="#FFFFFFFF" android:textStyle="bold" />
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#CCFFFFFF" android:maxLines="1" android:layout_weight="1.1"/>
        <TextView android:id="@+id/o_ha" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:textStyle="bold" android:layout_weight="1" android:gravity="center" android:background="@drawable/pill_fz" android:layout_marginEnd="3dp"/>
        <TextView android:id="@+id/o_hb" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:textStyle="bold" android:layout_weight="1" android:gravity="center" android:background="@drawable/pill_dy" android:layout_marginStart="3dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#CCFFFFFF" android:maxLines="1" android:layout_weight="1.1" android:text="İmsak"/>
        <TextView android:id="@+id/o_ia" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:textStyle="bold" android:layout_weight="1" android:gravity="center"/>
        <TextView android:id="@+id/o_ib" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:textStyle="bold" android:layout_weight="1" android:gravity="center"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#CCFFFFFF" android:maxLines="1" android:layout_weight="1.1" android:text="İftar"/>
        <TextView android:id="@+id/o_aa" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:textStyle="bold" android:layout_weight="1" android:gravity="center"/>
        <TextView android:id="@+id/o_ab" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:textStyle="bold" android:layout_weight="1" android:gravity="center"/>
    </LinearLayout>
</LinearLayout>
