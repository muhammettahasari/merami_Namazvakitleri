<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:gravity="center_vertical" android:background="@drawable/bg_tarih" android:paddingStart="14dp" android:paddingEnd="14dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/d_hicri" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FF9B6A1C" android:maxLines="1" android:textStyle="bold" android:fontFamily="serif"/>
        <TextView android:id="@+id/d_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FF7A8592" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/d_loc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FF7A8592" android:maxLines="1" />
        <TextView android:id="@+id/d_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FF18794A" android:maxLines="1" android:textStyle="bold" />
        <Chronometer android:id="@+id/d_ch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FF17212B" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
